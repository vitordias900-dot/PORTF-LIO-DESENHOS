{
  "compilerOptions": {
    "target": "es2020",
    "lib": ["es2020", "dom"],
    "rootDir": "src",
    "outDir": "js",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "sourceMap": true
  },
  "include": ["src"]
}